{
  "name": "por-sps-upi",
  "private": true,
  "version": "1.0.0",
  "description": "Website akademik Program Studi Pendidikan Olahraga (S2 & S3), Sekolah Pascasarjana Universitas Pendidikan Indonesia.",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port=4173 --host=0.0.0.0",
    "clean": "rm -rf dist dist-ssr",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^14.14.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
